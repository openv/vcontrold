<?xml version="1.0"?>
<V-Control xmlns:vcontrol="http://www.openv.de/vcontrol">

  <!-- ===================== -->
  <!-- UNIX / RUNTIME CONFIG -->
  <!-- ===================== -->

  <unix>
    <config>
      <serial>
        <tty>/dev/ttyUSB0</tty>
      </serial>

      <net>
        <port>3002</port>
        <!-- vcontrold 0.98.12 wertet <allow> nicht aus. -->
        <listen>127.0.0.1</listen>
      </net>

      <logging>
        <file>/var/log/vcontrold/vcontrold.log</file>
        <syslog>n</syslog>
        <debug>n</debug>
      </logging>

      <readonly>y</readonly>

      <!-- Muss zur vito.xml passen -->
      <device ID="20C8" />
    </config>
  </unix>

  <!-- ===================== -->
  <!-- UNITS (VOLLSTAENDIG) -->
  <!-- ===================== -->

  <units>

    <!-- ===== Energie ===== -->

    <unit name="KiloWattStunden">
      <abbrev>KW</abbrev>
      <calc get="V" set="V" />
      <type>uint</type>
      <entity>kWh</entity>
    </unit>

    <unit name="KiloWattSolar">
      <abbrev>KWS</abbrev>
      <calc get="V/1000" set="V*1000" />
      <type>uint</type>
      <entity>kWh</entity>
    </unit>

    <!-- ===== Temperaturen ===== -->

    <unit name="Temperatur">
      <abbrev>UT</abbrev>
      <calc get="V/10" set="V*10" />
      <type>short</type>
      <entity>Grad Celsius</entity>
    </unit>

    <unit name="Temperatur100">
      <abbrev>UTH</abbrev>
      <calc get="V/100" set="V*100" />
      <type>short</type>
      <entity>Grad Celsius</entity>
    </unit>

    <unit name="Temperatur 1Byte">
      <abbrev>UT1</abbrev>
      <calc get="V/2" set="V*2" />
      <type>char</type>
      <entity>Grad Celsius</entity>
    </unit>

    <unit name="Temperatur 1Byte unsigned">
      <abbrev>UT1U</abbrev>
      <calc get="V/2" set="V*2" />
      <type>uchar</type>
      <entity>Grad Celsius</entity>
    </unit>

    <unit name="Temperatur 1Byte ganzzahlig">
      <abbrev>UTI</abbrev>
      <calc get="V" set="V" />
      <type>uchar</type>
      <entity>Grad Celsius</entity>
    </unit>

    <!-- ===== Heizkennlinie ===== -->

    <unit name="Neigung">
      <abbrev>UN</abbrev>
      <calc get="V/10" set="V*10" />
      <type>uchar</type>
      <entity />
    </unit>

    <unit name="Niveau 1Byte signed">
      <abbrev>NI1</abbrev>
      <calc get="V" set="V" />
      <type>char</type>
      <entity>Kelvin</entity>
    </unit>

    <unit name="Status">
      <abbrev>ST</abbrev>
      <calc get="V" set="V" />
      <type>char</type>
    </unit>

    <!-- ===== Counter / Zeiten ===== -->

    <unit name="Counter">
      <abbrev>CO</abbrev>
      <calc get="V" set="V" />
      <type>uint</type>
    </unit>

    <unit name="Counter 16Bit">
      <abbrev>CO16</abbrev>
      <calc get="V" set="V" />
      <type>ushort</type>
    </unit>

    <unit name="CounterS">
      <abbrev>CS</abbrev>
      <calc get="V/3600" set="V*3600" />
      <type>uint</type>
      <entity>Stunden</entity>
    </unit>

    <!-- ===== Prozent ===== -->

    <unit name="Prozent">
      <abbrev>PR</abbrev>
      <calc get="V/2" set="V*2" />
      <type>short</type>
      <entity>%</entity>
    </unit>

    <unit name='Prozent 1 Byte ganzzahlig'>
      <abbrev>PR1</abbrev>
      <calc get='V' set='V' />
      <type>uchar</type>
      <entity>%</entity>
    </unit>

    <!-- ===== Rueckmeldungen ===== -->

    <unit name="ReturnStatus">
      <abbrev>RT</abbrev>
      <type>enum</type>
      <enum bytes="00" text="0" />
      <enum bytes="01" text="1" />
      <enum text="NOT OK" />
    </unit>

    <unit name="Flammenstatus 20C8">
      <abbrev>FLS20C8</abbrev>
      <type>enum</type>
      <enum bytes="00" text="0" />
      <enum bytes="0B" text="1" />
      <enum text="UNKNOWN" />
    </unit>

    <unit name="Sammelstoerung 20C8">
      <abbrev>FS20C8</abbrev>
      <type>enum</type>
      <enum bytes="00" text="KEINE STOERUNG" />
      <enum bytes="01" text="STOERUNG" />
      <enum text="UNKNOWN" />
    </unit>

    <unit name="SetReturnStatus">
      <abbrev>SR</abbrev>
      <type>enum</type>
      <enum bytes="00" text="OK" />
      <enum bytes="05" text="SYNC (NOT OK)" />
      <enum text="NOT OK" />
    </unit>

    <!-- ===== Betriebsarten ===== -->

    <unit name="BetriebsArt">
      <abbrev>BA</abbrev>
      <type>enum</type>
      <enum bytes="00" text="WW" />
      <enum bytes="01" text="RED" />
      <enum bytes="02" text="NORM" />
      <enum bytes="03" text="H+WW" />
      <enum bytes="04" text="H+WW FS" />
      <enum bytes="05" text="ABSCHALT" />
      <enum text="UNKNOWN" />
    </unit>

    <unit name="BetriebsArt 20C8">
      <abbrev>BA20C8</abbrev>
      <type>enum</type>
      <enum bytes="00" text="ABSCHALT" />
      <enum bytes="01" text="WW" />
      <enum bytes="02" text="H+WW" />
      <enum bytes="03" text="RED" />
      <enum bytes="04" text="NORM" />
      <enum text="UNKNOWN" />
    </unit>

    <!-- ===== Systemzeit ===== -->

    <unit name="SystemTime">
      <abbrev>TI</abbrev>
      <type>systime</type>
    </unit>

    <!-- ===== Geraetedaten ===== -->

    <unit name="DeviceType">
      <abbrev>DT</abbrev>
      <type>enum</type>
      <enum bytes="20 C8" text="Device ID 20C8 / VPlusHO1" />
      <enum text="UNKNOWN" />
    </unit>

    <unit name="Sachnummer">
      <abbrev>SN</abbrev>
      <type>uint</type>
      <icalc
        get="((((((((((((B0-48)*10)+(B1-48))*10)+(B2-48))*10)+(B3-48))*10)+(B4-48))*10)+(B5-48))*10)+B6-48" />
    </unit>

  </units>

  <!-- ===================== -->
  <!-- PROTOCOLS -->
  <!-- ===================== -->

  <protocols>

    <!-- ===== P300 ===== -->

    <protocol name="P300">
      <pid>41</pid>

      <macros>
        <macro name="GETADDR">
          <command>SEND 00 01</command>
        </macro>
        <macro name="SETADDR">
          <command>SEND 00 02</command>
        </macro>
      </macros>

      <commands>

        <command name="getaddr">
          <send>GETADDR $addr $hexlen;RECV $len $unit</send>
        </command>

        <command name="setaddr">
          <retry>2</retry>
          <recvTimeout>1000</recvTimeout>
          <send>SETADDR $addr $hexlen;SEND BYTES $unit;RECV 1 SR</send>
        </command>

      </commands>
    </protocol>

    <!-- ===== KW2 (optional / nicht aktiv) ===== -->

    <protocol name="KW2">
      <macros>
        <macro name="SYNC">
          <command>SEND 04;WAIT 05</command>
        </macro>
        <macro name="GETADDR">
          <command>SEND 01 F7</command>
        </macro>
        <macro name="SETADDR">
          <command>SEND 01 F4</command>
        </macro>
      </macros>

      <commands>
        <command name="getaddr">
          <retry>3</retry>
          <recvTimeout>4000</recvTimeout>
          <send>SYNC;GETADDR $addr $hexlen;RECV $len $unit</send>
        </command>

        <command name="setaddr">
          <send>SYNC;SETADDR $addr $hexlen;SEND BYTES $unit;RECV 1 SR</send>
        </command>

      </commands>
    </protocol>

  </protocols>

  <!-- ===================== -->
  <!-- EXTERNAL vito.xml -->
  <!-- ===================== -->

  <extern xmlns:xi="http://www.w3.org/2003/XInclude">
    <xi:include href="vito.xml" parse="xml" />
  </extern>

</V-Control>
